# /etc/mi/mi.env — mode 0600, owner root:mi. Secrets are read by NAME; never commit this file.
MI_DATA_DIR=/srv/mi/data
MI_BASE_URL=https://beta.example.com
MI_SECRET_KEY=                      # 64 random hex chars: python3 -c "import secrets;print(secrets.token_hex(32))"

# simulated = no paid call can leave the host. Switch to live only with a founder-authorised budget.
MI_PROVIDER_MODE=simulated
MI_REASONING_MODE=simulated
MI_HOLD_BEFORE_PREVIEW=1            # operator looks at every cut before the customer (early beta)

# Reasoning
ANTHROPIC_API_KEY=
MI_CREATIVE_MODEL=claude-opus-5
MI_REVIEWER_PROVIDER=gemini         # independent family; sees the assembled MP4 with sound
MI_REVIEWER_MODEL=gemini-3.5-flash
# MI_PRICE_GEMINI_3_5_FLASH=1.50,9.00   # USD per M tokens in,out (pinned in product/reasoning.py from the price page, 2026-09-23)

# Providers (credits pools only — never unrelated company accounts)
GOOGLE_API_KEY=                     # Gemini API: nano-banana-2 stills (+ reviewer)
MI_VERTEX_SA_JSON=/etc/mi/vertex-sa.json   # service-account key file, 0600: Veo i2v + Lyria
MI_VERTEX_PROJECT=
MI_VERTEX_REGION=us-central1

# Fonts for exact text (brand fonts may be installed and pointed to here)
MI_FONT_REGULAR=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
MI_FONT_BOLD=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf
MI_FONT_DEVANAGARI=/usr/share/fonts/truetype/noto/NotoSansDevanagari-Regular.ttf
MI_BACKUP_BUCKET=                   # e.g. gs://<bucket>/mi-backups (copy off-host after each nightly backup)
