{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eval/experiments/EVAL-037/schemas/attempt-ledger.schema.json",
  "title": "EVAL-037 attempt ledger",
  "description": "Every provider attempt made in one lane, in order, including failed ones. Attempts are never deleted, rewritten or reordered. A retry is licensed ONLY by a transient failure class; creative weakness is NEVER a legal reason for another attempt.",
  "type": "object",
  "additionalProperties": false,
  "required": ["experiment", "lane_id", "branch", "substrate", "runner_commit", "model", "condition", "attempts"],
  "properties": {
    "experiment": { "const": "EVAL-037" },
    "lane_id": { "type": "string", "pattern": "^((sol|sonnet|haiku|gemma)-(no|full)-canon|gemma-controlled-canon)$" },
    "branch": { "type": "string", "pattern": "^work/eval-037-" },
    "substrate": { "$ref": "#/$defs/substrate" },
    "runner_commit": {
      "type": "string", "pattern": "^[0-9a-f]{40}$",
      "description": "Commit that froze the runner. MUST predate every attempt in this ledger."
    },
    "model": { "type": "string" },
    "condition": { "enum": ["NO_CANON", "FULL_CANON"] },
    "treatment": { "type": ["string", "null"], "enum": [null, "CONTROLLED_CANON"], "description": "Supplemental treatment, or null for the original untreated lanes. CONTROLLED_CANON makes Canon research mandatory, objective-driven and mechanically bounded: <=3 searches, <=6 results each, <=2 reads per research question, <=4 reads per trial. The model still chooses the question, the wording, the objects and the application." },
    "attempts": { "type": "array", "items": { "$ref": "#/$defs/attempt" } }
  },
  "$defs": {
    "substrate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["freeze_fingerprint", "canon_base_commit", "execution_commit"],
      "description": "Substrate identity. The bytes are the authority. canon_base_commit is Canon provenance ONLY and does not contain EVAL-037.",
      "properties": {
        "freeze_fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "canon_base_commit": { "const": "c6f8d910f7a3cdaaeafa2280313abfb9b898cddd" },
        "execution_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "description": "Summed across every provider turn, tool turns included. A field no turn reported is null; *_turns_reporting says how many turns contributed, so a partial sum cannot pass as complete.",
      "properties": {
        "input_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "input_tokens_turns_reporting": { "type": "integer", "minimum": 0 },
        "cached_input_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "cached_input_tokens_turns_reporting": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "output_tokens_turns_reporting": { "type": "integer", "minimum": 0 },
        "reasoning_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "reasoning_tokens_turns_reporting": { "type": "integer", "minimum": 0 },
        "provider_turns": { "type": "integer", "minimum": 0 },
        "latency_ms": { "type": "integer", "minimum": 0 }
      }
    },
    "turn": {
      "type": "object",
      "additionalProperties": true,
      "required": ["turn_index", "provider", "input_tokens", "output_tokens", "stop_reason", "latency_ms"],
      "description": "ONE provider invocation, including an intermediate turn caused by a tool call. Unexposed fields are null, never invented.",
      "properties": {
        "turn_index": { "type": "integer", "minimum": 0 },
        "provider": { "type": "string" },
        "provider_model_version": { "type": ["string", "null"] },
        "provider_request_id": { "type": ["string", "null"] },
        "input_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "cached_input_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "output_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "reasoning_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "stop_reason": { "type": ["string", "null"] },
        "latency_ms": { "type": ["integer", "null"], "minimum": 0 },
        "provider_reported_usage": { "type": ["object", "null"] }
      }
    },
    "tool_call": {
      "type": "object",
      "additionalProperties": true,
      "required": ["turn_index", "name", "arguments", "arguments_digest", "result_digest", "tool_family", "result_item_count"],
      "description": "A complete tool-call record: real arguments and per-item identity, not only hashes and counts.",
      "properties": {
        "turn_index": { "type": "integer", "minimum": 0 },
        "name": { "enum": ["canon_catalog", "canon_search", "canon_read", "website_read"] },
        "tool_family": { "enum": ["canon", "website"] },
        "arguments": { "type": "object" },
        "arguments_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "result_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "result_bytes": { "type": "integer", "minimum": 0 },
        "result_item_count": { "type": "integer", "minimum": 0 },
        "transcript_ref": {
          "type": "string",
          "description": "Exact reproducible reference to the full tool result on disk."
        },
        "accepted_items": { "type": "integer", "minimum": 0 },
        "hold_items": { "type": "integer", "minimum": 0 },
        "qa_items": { "type": "integer", "minimum": 0 },
        "every_item_carried_source_status": { "const": true },
        "retrieved_refs": {
          "type": "array",
          "description": "Per-item identity for everything the model actually received.",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["item_id", "source_status", "kind", "is_qa"],
            "properties": {
              "item_id": { "type": ["string", "null"] },
              "source_id": { "type": ["string", "null"] },
              "source_dir": { "type": ["string", "null"] },
              "source_status": { "enum": ["ACCEPTED", "HOLD"] },
              "kind": { "type": "string" },
              "is_qa": { "type": "boolean" },
              "not_benchmark_ground_truth": { "type": ["boolean", "null"] },
              "rank": { "type": ["integer", "null"] },
              "score": { "type": ["number", "null"] }
            }
          }
        },
        "source_url": { "type": ["string", "null"] },
        "snapshot_path": { "type": ["string", "null"] },
        "snapshot_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "source_html_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "content_chars": { "type": ["integer", "null"], "minimum": 0 },
        "live_browsing": { "const": false }
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trial_id", "brief_id", "repetition", "attempt_index", "attempt_kind", "phase", "started_at", "ended_at", "outcome", "fresh_context", "request_digest", "request_path"],
      "properties": {
        "trial_id": { "type": "string", "pattern": "^(E037-(sol|sonnet|haiku|gemma)-(no|full)-canon|E037GCC-gemma)-B0[1-6]-R[1-3]$" },
        "brief_id": { "enum": ["B01", "B02", "B03", "B04", "B05", "B06"] },
        "repetition": { "type": "integer", "minimum": 1, "maximum": 3 },
        "attempt_index": { "type": "integer", "minimum": 0, "maximum": 5 },
        "attempt_kind": {
          "enum": ["initial", "technical_retry", "format_repair", "format_repair_technical_retry"],
          "description": "technical_retry follows a TRANSIENT failure only. format_repair happens at most once. format_repair_technical_retry retries THAT repair, never a fresh generation."
        },
        "phase": { "enum": ["creative", "repair"] },
        "failure_class": {
          "enum": ["timeout", "connection_error", "rate_limit_429", "server_error_5xx",
                   "invalid_request_4xx", "auth_error", "tool_schema_rejected",
                   "context_overflow", "tool_loop_guard_exhausted", "model_refusal",
                   "truncated_response", "empty_response", "sdk_error", null]
        },
        "failure_is_transient": { "type": "boolean" },
        "started_at": { "type": "string" },
        "ended_at": { "type": "string" },
        "outcome": { "enum": ["ok", "format_invalid", "transient_failure", "deterministic_failure"] },
        "fresh_context": { "const": true },
        "request_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "request_path": {
          "type": "string",
          "description": "The EXACT serialised request, retained on disk — not only a digest."
        },
        "response_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "raw_response_path": { "type": "string" },
        "transcript_path": { "type": ["string", "null"] },
        "repair_source_response_digest": {
          "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$",
          "description": "Digest of the ORIGINAL answer carried into a repair request. Required on every repair-phase attempt."
        },
        "provider_turns": { "type": "array", "items": { "$ref": "#/$defs/turn" } },
        "usage": { "anyOf": [{ "$ref": "#/$defs/usage" }, { "type": "null" }] },
        "price_snapshot": { "type": "string" },
        "calculated_cost_usd": { "type": ["number", "null"], "minimum": 0 },
        "cost_basis": { "type": "string" },
        "tool_calls": { "type": "array", "items": { "$ref": "#/$defs/tool_call" } },
        "website_reads": { "type": "array", "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" } },
        "error": { "type": ["string", "null"] },
        "note": { "type": ["string", "null"], "description": "Mechanical note only. Never a creative judgement." }
      },
      "allOf": [
        {
          "if": { "properties": { "outcome": { "const": "transient_failure" } }, "required": ["outcome"] },
          "then": {
            "required": ["failure_class", "failure_is_transient"],
            "properties": {
              "failure_is_transient": { "const": true },
              "failure_class": { "enum": ["timeout", "connection_error", "rate_limit_429", "server_error_5xx"] }
            }
          }
        },
        {
          "if": { "properties": { "outcome": { "const": "deterministic_failure" } }, "required": ["outcome"] },
          "then": {
            "required": ["failure_class", "failure_is_transient"],
            "properties": {
              "failure_is_transient": { "const": false },
              "failure_class": {
                "enum": ["invalid_request_4xx", "auth_error", "tool_schema_rejected",
                         "context_overflow", "tool_loop_guard_exhausted", "model_refusal",
                         "truncated_response", "empty_response", "sdk_error"]
              }
            }
          }
        },
        {
          "if": { "properties": { "attempt_kind": { "const": "initial" } }, "required": ["attempt_kind"] },
          "then": { "properties": { "attempt_index": { "const": 0 }, "phase": { "const": "creative" } } }
        },
        {
          "if": { "properties": { "attempt_kind": { "const": "technical_retry" } }, "required": ["attempt_kind"] },
          "then": { "properties": { "attempt_index": { "type": "integer", "minimum": 1, "maximum": 2 }, "phase": { "const": "creative" } } }
        },
        {
          "if": { "properties": { "phase": { "const": "repair" } }, "required": ["phase"] },
          "then": {
            "required": ["repair_source_response_digest"],
            "properties": {
              "repair_source_response_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "attempt_kind": { "enum": ["format_repair", "format_repair_technical_retry"] }
            }
          }
        }
      ]
    }
  }
}
