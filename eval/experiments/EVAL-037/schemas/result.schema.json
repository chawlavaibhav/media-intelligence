{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eval/experiments/EVAL-037/schemas/result.schema.json",
  "title": "EVAL-037 lane result",
  "description": "The sealed result of one lane: exactly 18 trials, one model, one condition. Contains NO creative-quality judgement of any kind and NO media. Scoring and media generation are outside EVAL-037.",
  "type": "object",
  "additionalProperties": false,
  "required": ["experiment", "lane_id", "branch", "substrate", "runner_commit", "provider", "model", "condition", "trial_count", "price_snapshot", "lane_usage_totals", "trials"],
  "properties": {
    "experiment": { "const": "EVAL-037" },
    "lane_id": { "type": "string", "pattern": "^(sol|sonnet|haiku|gemma)-(no|full|controlled)-canon$" },
    "branch": { "type": "string", "pattern": "^work/eval-037-" },
    "substrate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["freeze_fingerprint", "canon_base_commit", "execution_commit"],
      "description": "The substrate BYTES are the authority. canon_base_commit is Canon provenance only; it does not contain EVAL-037 and is not the starting commit.",
      "properties": {
        "freeze_fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "canon_base_commit": { "const": "c6f8d910f7a3cdaaeafa2280313abfb9b898cddd" },
        "execution_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "runner_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "provider": { "enum": ["OpenAI", "Anthropic", "Google Gemini API"] },
    "model": {
      "type": "string",
      "description": "The exact resolved model id actually served. Moving aliases are forbidden.",
      "not": { "pattern": "(latest|preview$)" }
    },
    "condition": { "enum": ["NO_CANON", "FULL_CANON", "CONTROLLED_CANON"] },
    "canon_fingerprints": {
      "type": "object",
      "description": "Recorded by any Canon condition (FULL_CANON, CONTROLLED_CANON). Absent in NO_CANON, which must not read the corpus at all.",
      "additionalProperties": false,
      "required": ["full_knowledge", "qa"],
      "properties": {
        "full_knowledge": { "const": "cbd321aa3be7464e785a0d42de1764cdccc8bdd33bc023a376740f8f196bde60" },
        "qa": { "const": "1313c0babe2194a7bc71c1628f9fbec5fa4f35ca5ff5edc7f594662101dc62bd" }
      }
    },
    "price_snapshot": { "type": "string" },
    "lane_usage_totals": { "$ref": "#/$defs/usage" },
    "lane_calculated_cost_usd": { "type": ["number", "null"], "minimum": 0 },
    "lane_cost_basis": { "type": "string" },
    "trial_count": { "const": 18 },
    "trials": { "type": "array", "minItems": 18, "maxItems": 18, "items": { "$ref": "#/$defs/trial" } }
  },
  "$defs": {
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "input_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "input_tokens_turns_reporting": { "type": "integer", "minimum": 0 },
        "cached_input_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "cached_input_tokens_turns_reporting": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "output_tokens_turns_reporting": { "type": "integer", "minimum": 0 },
        "reasoning_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "reasoning_tokens_turns_reporting": { "type": "integer", "minimum": 0 },
        "provider_turns": { "type": "integer", "minimum": 0 },
        "latency_ms": { "type": "integer", "minimum": 0 }
      }
    },
    "trial": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trial_id", "brief_id", "repetition", "order_index", "status", "attempts_used", "fresh_context", "package_path", "package_digest", "eligible_for_media_generation", "website_tool_exposed", "website_snapshot_used", "usage_totals"],
      "properties": {
        "trial_id": { "type": "string", "pattern": "^(E037-(sol|sonnet|haiku|gemma)-(no|full)-canon|E037SCC-sonnet)-B0[1-6]-R[1-3]$" },
        "brief_id": { "enum": ["B01", "B02", "B03", "B04", "B05", "B06"] },
        "brief_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "repetition": { "type": "integer", "minimum": 1, "maximum": 3 },
        "order_index": { "type": "integer", "minimum": 1, "maximum": 18 },
        "status": {
          "enum": ["complete", "format_repaired", "failed_format", "failed_technical", "failed_execution", "failed_controlled_retrieval"],
          "description": "complete = valid, no repair. format_repaired = valid AFTER the one permitted format repair. failed_format = the repair ran and the answer is still structurally invalid; the output is retained and is NOT called repaired. failed_technical = transient retries exhausted. failed_execution = a deterministic failure (bad request, context overflow, tool-loop guard, refusal, truncation) which is never resampled. failed_controlled_retrieval = CONTROLLED_CANON only: the package is structurally valid but the model exceeded the treatment's retrieval allowance, so the trial is not a valid observation OF the treatment; the output is retained and the trial is NEVER re-run. There is no 'weak' status: creative quality is not judged here."
        },
        "attempts_used": { "type": "integer", "minimum": 1, "maximum": 6 },
        "transient_retries_used": { "type": "integer", "minimum": 0, "maximum": 4 },
        "format_repairs_used": { "type": "integer", "minimum": 0, "maximum": 1 },
        "repair_source_response_digest": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "fresh_context": { "const": true },
        "package_path": { "type": ["string", "null"] },
        "package_digest": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "sections_present": {
          "type": "array",
          "description": "Mechanical presence check of the 12 required sections. Presence only, never a quality opinion.",
          "items": {
            "enum": ["DELIVERABLE", "OBJECTIVE_INTERPRETATION", "CORE_CREATIVE_IDEA",
                     "MESSAGE_AND_INFORMATION_HIERARCHY", "VISUAL_SYSTEM", "PRODUCTION_RECIPE",
                     "GENERATION_PROMPTS", "DETERMINISTIC_OR_NON_GENERATIVE_ELEMENTS",
                     "AUDIO_AND_EDIT", "FAILURE_PREVENTION", "HARD_CONSTRAINT_CHECK",
                     "KNOWLEDGE_AND_WEBSITE_USE"]
          }
        },
        "eligible_for_media_generation": {
          "type": "boolean",
          "description": "True for every structurally valid package. Never withdrawn on creative grounds. Media generation itself is outside EVAL-037."
        },
        "canon_used": { "type": ["boolean", "null"], "description": "Canon conditions only; null in NO_CANON. An observation, not a requirement." },
        "canon_tool_calls": { "type": "integer", "minimum": 0 },
        "controlled_retrieval": {
          "type": ["object", "null"],
          "additionalProperties": true,
          "description": "CONTROLLED_CANON only; null otherwise. What the model ACTUALLY retrieved, measured against the treatment allowance after the fact. enforced_by_harness is const false: the allowance is an experimental treatment, never a technical guard, so nothing was capped, blocked or repaired at run time.",
          "properties": {
            "treatment": { "const": "CONTROLLED_CANON" },
            "enforced_by_harness": { "const": false },
            "limits": { "type": "object" },
            "declared_knowledge_needs": { "type": "array", "items": { "type": "string" } },
            "declared_knowledge_needs_count": { "type": "integer", "minimum": 0 },
            "canon_search_calls": { "type": "integer", "minimum": 0 },
            "canon_read_calls": { "type": "integer", "minimum": 0 },
            "canon_catalog_calls": { "type": "integer", "minimum": 0 },
            "searches": { "type": "array" },
            "search_results_total": { "type": "integer", "minimum": 0 },
            "canon_read_objects": { "type": "array" },
            "violations": { "type": "array", "items": { "type": "string" } },
            "compliant": { "type": "boolean" }
          }
        },
        "canon_items_returned": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "accepted": { "type": "integer", "minimum": 0 },
            "hold": { "type": "integer", "minimum": 0 },
            "qa": { "type": "integer", "minimum": 0 }
          }
        },
        "website_tool_exposed": {
          "type": "boolean",
          "description": "True for B01/B02 in BOTH conditions; false for B03-B06 in both."
        },
        "website_tool_calls": { "type": "integer", "minimum": 0 },
        "website_snapshot_used": {
          "type": "boolean",
          "description": "Derived from actual tool calls. Never hardcoded."
        },
        "website_snapshot_digests": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "description": "The exact snapshot digests served to the model."
        },
        "usage_totals": { "$ref": "#/$defs/usage" },
        "price_snapshot": { "type": "string" },
        "calculated_cost_usd": { "type": ["number", "null"], "minimum": 0 },
        "cost_basis": { "type": "string" },
        "wall_clock_ms": { "type": "integer", "minimum": 0 }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "failed_technical" } }, "required": ["status"] },
          "then": { "properties": { "package_path": { "const": null }, "eligible_for_media_generation": { "const": false } } }
        },
        {
          "if": { "properties": { "status": { "const": "failed_execution" } }, "required": ["status"] },
          "then": { "properties": { "package_path": { "const": null }, "eligible_for_media_generation": { "const": false } } }
        },
        {
          "if": { "properties": { "status": { "const": "failed_format" } }, "required": ["status"] },
          "then": {
            "properties": {
              "format_repairs_used": { "const": 1 },
              "eligible_for_media_generation": { "const": false },
              "package_path": { "type": "string" },
              "repair_source_response_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          }
        },
        {
          "if": { "properties": { "status": { "const": "format_repaired" } }, "required": ["status"] },
          "then": {
            "properties": {
              "format_repairs_used": { "const": 1 },
              "eligible_for_media_generation": { "const": true },
              "repair_source_response_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          }
        },
        {
          "if": { "properties": { "status": { "const": "failed_controlled_retrieval" } }, "required": ["status"] },
          "then": {
            "properties": {
              "eligible_for_media_generation": { "const": false },
              "package_path": { "type": "string" },
              "controlled_retrieval": { "type": "object" }
            }
          }
        },
        {
          "if": { "properties": { "status": { "const": "complete" } }, "required": ["status"] },
          "then": {
            "properties": {
              "format_repairs_used": { "const": 0 },
              "eligible_for_media_generation": { "const": true },
              "repair_source_response_digest": { "const": null }
            }
          }
        },
        {
          "if": { "properties": { "brief_id": { "enum": ["B03", "B04", "B05", "B06"] } }, "required": ["brief_id"] },
          "then": {
            "properties": {
              "website_tool_exposed": { "const": false },
              "website_tool_calls": { "const": 0 },
              "website_snapshot_used": { "const": false }
            }
          }
        },
        {
          "if": { "properties": { "brief_id": { "enum": ["B01", "B02"] } }, "required": ["brief_id"] },
          "then": { "properties": { "website_tool_exposed": { "const": true } } }
        }
      ]
    }
  }
}
