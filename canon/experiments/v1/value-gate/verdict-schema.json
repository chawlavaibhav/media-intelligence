{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Canon V1 value-gate human verdict",
  "description": "One reviewer's blind judgement of one PAIR. Produced by a human. Never produced by an agent. The scoring script consumes this file and contains no default, inferred or placeholder verdicts.",
  "type": "object",
  "required": ["pair_id", "reviewer_id", "reviewed_at", "dimensions", "overall"],
  "additionalProperties": false,
  "properties": {
    "pair_id": {"type": "string", "pattern": "^PAIR-[0-9]{2}$"},
    "reviewer_id": {"type": "string"},
    "reviewed_at": {"type": "string"},
    "dimensions": {
      "type": "object",
      "description": "Per dimension, which presented plan the reviewer judged better. A and B are blinded labels whose arm mapping is held in the sealed key.",
      "required": [
        "concept_quality", "hierarchy_reasoning", "proposition_clarity", "objective_fit",
        "audience_fit", "visual_temporal_strategy", "trade_off_awareness",
        "contradiction_handling", "appropriate_specificity"
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z_]+$": {"enum": ["A", "B", "neither", "cannot_tell"]}
      }
    },
    "explicit_intent_preservation": {
      "type": "object",
      "description": "GATING dimension, scored per plan and never averaged into creative quality. A plan that drops or alters an explicit client requirement fails this regardless of how good it is.",
      "required": ["A", "B"],
      "additionalProperties": false,
      "properties": {
        "A": {"$ref": "#/definitions/intent"},
        "B": {"$ref": "#/definitions/intent"}
      }
    },
    "overall": {"enum": ["A", "B", "neither", "cannot_tell"]},
    "reviewer_comment": {"type": ["string", "null"]}
  },
  "definitions": {
    "intent": {
      "type": "object",
      "required": ["verdict", "violations"],
      "additionalProperties": false,
      "properties": {
        "verdict": {"enum": ["preserved", "degraded", "violated"]},
        "violations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "detail"],
            "additionalProperties": false,
            "properties": {
              "kind": {"enum": ["exact_string_altered", "requirement_dropped", "constraint_broken", "fact_invented", "contradiction_resolved_silently"]},
              "detail": {"type": "string"}
            }
          }
        }
      }
    }
  }
}
