.DS_Store
node_modules/
*.log
.env
.env.local

# Large/local corpus payloads. Keep manifests, reports and source records in git; not raw media.
resources/corpus/raw/
resources/corpus/staging/
resources/corpus/tmp/

# Python bytecode caches - build artefacts, never source of truth.
__pycache__/
*.pyc

# Deterministic build products of resources/v1 validators (R-C3 of RESOURCES-V1-CORRECTION-PASS).
# Views and the synthetic scale archive are rebuilt from the committed manifest + generators; their
# committed fingerprints prove any rebuild is byte-identical. Irreplaceable class-C model outputs are
# NOT covered by this rule and must never be git-ignored.
resources/v1/build/

# EMP-001 runtime authorisation. Materialised only from an explicit human approval at
# execution time; never committed. The committed schema is authorization.example.yaml.
eval/empirical-tranche-1/authorization.local.yaml

# Reproducible render products of the EMP-001 Latin pack. Rebuild with:
#   python3 eval/empirical-tranche-1/text_qualification/render_latin_pack.py
eval/empirical-tranche-1/text_qualification/build/
