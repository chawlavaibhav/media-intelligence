{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "media-agency/forms/form-4-selection",
  "title": "Stage 4 — Production selection (riskiest element first; every route has evidence or a test; balances read)",
  "description": "Template lines 4.1–4.10.",
  "type": "object",
  "required": ["job_id", "author_session", "risk_order", "routes", "known_failures", "composited", "generated_text_planned", "voice", "references", "pools_read", "expected_spend", "order_of_work", "decision"],
  "properties": {
    "job_id": {"type": "string", "minLength": 1},
    "author_session": {"type": "string", "minLength": 1},
    "risk_order": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "required": ["rank", "element", "why", "evidence_ref", "test"], "properties": {
        "rank": {"type": "integer", "minimum": 1},
        "element": {"type": "string", "minLength": 1},
        "beat": {"type": "integer"},
        "why": {"type": "string", "minLength": 1},
        "evidence_ref": {"type": "string", "minLength": 1, "description": "4.1 a case id, registry cell or MF prior — not the author's label"},
        "test": {"type": "object", "required": ["what", "cost_usd", "judged_by"], "properties": {
          "what": {"type": "string", "minLength": 1, "description": "the micro-qualification draw"},
          "cost_usd": {"type": "number", "minimum": 0},
          "judged_by": {"type": "string", "minLength": 1}
        }}
      }}
    },
    "routes": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "required": ["asset_class", "route_id", "cell", "evidence_status", "production_use_allowed", "price_usd", "unit"], "properties": {
        "asset_class": {"type": "string", "minLength": 1},
        "route_id": {"type": "string", "minLength": 1},
        "cell": {"type": "string", "minLength": 1, "description": "TAINT-REGISTER cell"},
        "evidence_status": {"type": "string", "minLength": 1},
        "production_use_allowed": {"type": "string", "enum": ["true", "manual_only", "false"]},
        "price_usd": {"type": "number", "minimum": 0},
        "unit": {"type": "string", "minLength": 1},
        "pool": {"type": "string"},
        "price_source": {"type": "string"}
      }}
    },
    "known_failures": {
      "type": "array",
      "items": {"type": "object", "required": ["route_id", "failure", "ref"], "properties": {
        "route_id": {"type": "string", "minLength": 1},
        "failure": {"type": "string", "minLength": 1},
        "ref": {"type": "string", "minLength": 1, "description": "4.3 case id / directional note / MF prior"}
      }}
    },
    "composited": {"type": "array", "items": {"type": "string"}, "description": "4.4 every text, logo or UI element — composed by code, never generated"},
    "generated_text_planned": {"type": "boolean", "enum": [false]},
    "voice": {"type": "object", "required": ["source_count"], "properties": {
      "source_count": {"type": "integer", "minimum": 0, "maximum": 1, "description": "4.5 one file or one take; 0 when there is no voice"},
      "measured_before_timeline": {"type": "boolean", "description": "4.6"}
    }},
    "references": {
      "type": "array",
      "items": {"type": "object", "required": ["for", "refs"], "properties": {
        "for": {"type": "string", "minLength": 1},
        "refs": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"type": "string"}, "description": "4.7 ≤ 4 per route"}
      }}
    },
    "pools_read": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "required": ["pool", "status", "read_utc"], "properties": {
        "pool": {"type": "string", "minLength": 1},
        "status": {"type": "string", "minLength": 1, "description": "4.8 read, not attested"},
        "read_utc": {"type": "string", "minLength": 1}
      }}
    },
    "expected_spend": {"type": "object", "required": ["first_pass_usd", "repair_allowance_usd", "total_usd"], "properties": {
      "first_pass_usd": {"type": "number", "minimum": 0},
      "repair_allowance_usd": {"type": "number", "minimum": 0},
      "total_usd": {"type": "number", "minimum": 0},
      "lines": {"type": "array", "items": {"type": "object"}}
    }},
    "order_of_work": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "decision": {"type": "object", "required": ["topology", "why", "rejected_alternatives"], "properties": {
      "topology": {"type": "string", "minLength": 1},
      "why": {"type": "string", "minLength": 1},
      "rejected_alternatives": {"type": "array", "items": {"type": "string"}}
    }}
  }
}
