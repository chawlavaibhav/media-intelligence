{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "media-agency/forms/form-1-intent",
  "title": "Stage 1 — Intent (what the customer asked for, what we decided, what we must ask)",
  "description": "Template lines 1.0–1.12. Every value is the author's judgement; the gate checks presence and traceability only.",
  "type": "object",
  "required": [
    "job_id", "author_session", "generative_only_acknowledged", "brief_verbatim",
    "deliverable", "objective", "distinctive_assets", "mandatory", "forbidden", "tone",
    "language", "channel", "cap", "approver", "acceptance", "flags", "decisions", "asks"
  ],
  "properties": {
    "job_id": {"type": "string", "minLength": 1},
    "author_session": {"type": "string", "minLength": 1, "description": "who filled this form (session id or name); the Stage 5 checker must differ"},
    "generative_only_acknowledged": {"type": "boolean", "enum": [true], "description": "line 1.0 — everything is produced by generative models; nothing is filmed"},
    "brief_verbatim": {"type": "string", "minLength": 1, "description": "the customer's words, unedited"},
    "deliverable": {
      "type": "object", "required": ["type", "count", "formats"],
      "properties": {
        "type": {"type": "string", "enum": ["static_image", "film"]},
        "count": {"type": "integer", "minimum": 1},
        "formats": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "duration_s_band": {"type": "array", "minItems": 2, "items": {"type": "number", "minimum": 0}, "description": "film only: [min, max]"}
      }
    },
    "objective": {
      "type": "object", "required": ["purpose", "viewer_should"],
      "properties": {
        "purpose": {"type": "string", "minLength": 1, "description": "1.2 ad / content / scene / demo"},
        "viewer_should": {"type": "string", "minLength": 1, "description": "1.2 what the viewer should feel or do"},
        "source": {"type": "string", "enum": ["preserve", "ask", "decide"]}
      }
    },
    "distinctive_assets": {
      "type": "array",
      "items": {"type": "object", "required": ["name", "must_be_exact"], "properties": {
        "name": {"type": "string", "minLength": 1},
        "must_be_exact": {"type": "array", "items": {"type": "string"}, "description": "1.3 marks, colours, label text that may not drift"}
      }}
    },
    "mandatory": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "required": ["id", "customer_words", "realisation", "verification"], "properties": {
        "id": {"type": "string", "pattern": "^M[0-9]+$"},
        "customer_words": {"type": "string", "minLength": 1},
        "realisation": {"type": "string", "minLength": 1, "description": "how the film/image will carry it"},
        "verification": {"type": "object", "required": ["class", "method"], "properties": {
          "class": {"type": "string", "enum": ["DET", "RSR", "LJ", "HJ", "EMC"]},
          "method": {"type": "string", "minLength": 1, "description": "1.4 mandatory per item — a row without one blocks Gate 1"}
        }}
      }}
    },
    "forbidden": {
      "type": "array",
      "items": {"type": "object", "required": ["item", "source"], "properties": {
        "item": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1, "description": "customer words, a fetched page, or a rule id"}
      }}
    },
    "tone": {"type": "object", "required": ["register"], "properties": {
      "register": {"type": "string", "minLength": 1},
      "example_accepted": {"type": "string", "description": "1.6 one example the customer accepts (or the brand's own line)"}
    }},
    "language": {"type": "object", "required": ["on_screen", "spoken"], "properties": {
      "on_screen": {"type": "string", "minLength": 1},
      "spoken": {"type": "string", "minLength": 1, "description": "'none' when there is no speech"}
    }},
    "channel": {"type": "object", "required": ["platforms"], "properties": {
      "platforms": {"type": "array", "minItems": 1, "items": {"type": "string"}},
      "placement": {"type": "string"}
    }},
    "cap": {"type": "object", "required": ["usd", "stated_by", "stated_utc"], "properties": {
      "usd": {"type": "number", "minimum": 0.01},
      "stated_by": {"type": "string", "minLength": 1, "description": "the human who stated it, verbatim source"},
      "stated_utc": {"type": "string", "minLength": 1},
      "verbatim": {"type": "string"}
    }},
    "deadline_utc": {"type": ["string", "null"]},
    "approver": {"type": "string", "minLength": 1, "description": "1.9 who accepts (C-8: the customer releases)"},
    "acceptance": {
      "type": "array", "minItems": 3,
      "items": {"type": "object", "required": ["id", "statement", "decidable_by"], "properties": {
        "id": {"type": "string", "pattern": "^A[0-9]+$"},
        "statement": {"type": "string", "minLength": 1, "description": "1.10 decidable from the file"},
        "decidable_by": {"type": "string", "enum": ["DET", "LJ", "HJ"]}
      }}
    },
    "flags": {
      "type": "array",
      "items": {"type": "object", "required": ["issue", "resolved"], "properties": {
        "issue": {"type": "string", "minLength": 1},
        "resolved": {"type": "boolean"},
        "resolution": {"type": "string"}
      }}
    },
    "decisions": {
      "type": "array",
      "items": {"type": "object", "required": ["id", "choice", "why", "cost_if_wrong", "source"], "properties": {
        "id": {"type": "string", "pattern": "^D[0-9]+$"},
        "choice": {"type": "string", "minLength": 1},
        "why": {"type": "string", "minLength": 1},
        "cost_if_wrong": {"type": "string", "minLength": 1},
        "source": {"type": "string", "enum": ["preserve", "ask", "decide", "lookup-fact", "lookup-canon", "evidence", "test"]},
        "refs": {"type": "array", "items": {"type": "string"}}
      }}
    },
    "asks": {
      "type": "array",
      "items": {"type": "object", "required": ["id", "question", "blocking"], "properties": {
        "id": {"type": "string", "pattern": "^Q[0-9]+$"},
        "question": {"type": "string", "minLength": 1},
        "blocking": {"type": "boolean", "description": "true = must be answered before spend; false = default recorded, proceed permitted"},
        "default": {"type": "string"},
        "answer": {"type": ["string", "null"]},
        "answered_by": {"type": "string"},
        "would_change": {"type": "string", "description": "which decision id the answer would change"}
      }}
    }
  }
}
